{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app00",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "257be5ae-4c1c-4b18-8ca9-ec18e0dba99c","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0fc72916d12b446a93b6eca45f7f8ea5" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
